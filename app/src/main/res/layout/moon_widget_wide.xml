<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="2dp"
    android:background="@android:color/transparent">
    <ImageView android:id="@+id/moon" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:contentDescription="Moon phase"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="2"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center_vertical" android:paddingStart="6dp">
        <TextView android:id="@+id/phase" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Curious"
            android:textColor="#FFFFFFFF" android:shadowColor="#DD000000"
            android:shadowRadius="3" android:shadowDx="1" android:shadowDy="1"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="2"/>
        <TextView android:id="@+id/illumination" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="50% illuminated"
            android:textColor="#FFE3E9F3" android:shadowColor="#DD000000"
            android:shadowRadius="3" android:shadowDx="1" android:shadowDy="1"
            android:textSize="11sp" android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
